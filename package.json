{
  "name": "@pulse/peacock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "node scripts/check-client-namespaces.mjs && node scripts/check-page-catalogue.mjs && node scripts/check-placeholders.mjs && tsx scripts/check-intent-ranking.ts && tsx scripts/check-requirement-parser.ts && tsx scripts/check-semantic-fallback.ts && next build && node scripts/check-seo.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:manifest": "node scripts/gen-asset-manifest.mjs",
    "deploy:r2": "tsx scripts/upload-to-r2.ts",
    "type-check": "tsc --noEmit",
    "check:pages": "node scripts/check-page-catalogue.mjs",
    "check:intent": "tsx scripts/check-intent-ranking.ts",
    "check:parser": "tsx scripts/check-requirement-parser.ts",
    "check:talk": "tsx scripts/check-talk.ts",
    "check:fallback": "tsx scripts/check-semantic-fallback.ts",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "cdn:restamp": "node scripts/restamp-r2-cache.mjs",
    "check:namespaces": "node scripts/check-client-namespaces.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "next-intl": "^4.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@tailwindcss/postcss": "^4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mime-types": "^3.0.2",
    "prettier": "3.7.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}

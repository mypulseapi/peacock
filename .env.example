# Every origin this site points at. Nothing here is a secret: all of it ends up in the HTML.
#
# `NEXT_PUBLIC_*` values are inlined at build time, which on GitHub Pages means they must be set on
# the workflow that runs `next build`. There is no runtime to read them later.
#
# A production build with any of the first seven missing FAILS, naming the variable. That is
# deliberate: a default that is a real production host keeps working when the variable is unset, so
# the variable never gets set and some deploy quietly ships the wrong domain. The only defaults in
# `src/lib/site.ts` are localhost, for `pnpm dev`.
#
# The values below are the production ones, so copying this file to `.env.local` gives a local
# build that points at live services.

# --- origins ---------------------------------------------------------------

# This site.
NEXT_PUBLIC_SITE_URL=https://thepulseapi.com

# The developer handbook, a separate repository and deployment.
NEXT_PUBLIC_DOCS_URL=https://developer.thepulseapi.com

# The merchant dashboard: sign-in, sign-up, API keys.
NEXT_PUBLIC_APP_URL=https://app.thepulseapi.com

# The public API gateway. The forms post here DIRECTLY now -- there is no server left to proxy
# through -- so the gateway must allow this site's origin in CORS or every form fails in the
# browser with nothing in any server log.
NEXT_PUBLIC_API_URL=https://api.thepulseapi.com

# Asset CDN. Images, videos and brand marks live here rather than in the repository;
# `img()` and `asset()` in src/lib/cdn.ts build every URL from this variable, so the hostname
# appears nowhere in the code.
#
# REQUIRED. `public/images` and `public/assets` have both been deleted now that their contents
# are in the bucket, so with this unset the helpers fall back to local paths that no longer
# exist and every image on the site 404s.
NEXT_PUBLIC_CDN_URL=https://cdn.thepulseapi.com

# The interactive demo storefront.
NEXT_PUBLIC_DEMO_URL=https://demo.thepulseapi.com

# The auth service. It sets the session cookie, so it is not this site's origin.
NEXT_PUBLIC_AUTH_URL=https://api.thepulseapi.com

# --- paths, so a route change needs no code change -------------------------

# Folder inside the R2 bucket holding this site's assets. The bucket is shared with the product
# (demo/, originals/, avatars/), so the site is namespaced.
NEXT_PUBLIC_CDN_PREFIX=website

# Serve the assistant's weights from our CDN rather than huggingface.co. 141MB across the two
# models, and with this off every first question on the site fetches them from a third party.
# Needs a CORS policy on the bucket allowing GET and HEAD from this origin: an <img> needs none
# and a fetch() does, so without it the panel reports that it could not start. Applied 2026-10-21.
NEXT_PUBLIC_CDN_MODELS=1

# Where the browser SDK is served from, under the CDN. Versioned by path, so releasing a new SDK
# is an environment change rather than an edit to a component.
NEXT_PUBLIC_SDK_PATH=/sdk/v0/pulse.iife.js

# The API's version prefix, appended to NEXT_PUBLIC_API_URL by `apiUrl()`.
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Deep links into the dashboard. These are paths on NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_SIGNIN_PATH=/signin
NEXT_PUBLIC_APP_SIGNUP_PATH=/register
NEXT_PUBLIC_APP_API_KEY_PATH=/settings/api

# --- contact -----------------------------------------------------------

# The addresses the contact page lists, and the one the form falls back to when a submission
# fails. Not secrets: they are published on a public contact page. They are here rather than in
# the markup because they were written in twice, once in each `mailto:` and again as the visible
# text in both message catalogues, so changing one meant finding four.
#
# An unset address drops its row rather than rendering a dead link, so a deployment that only
# wants one desk sets one variable.
NEXT_PUBLIC_CONTACT_EMAIL=getintouch@thepulseapi.com
NEXT_PUBLIC_SALES_EMAIL=sales@thepulseapi.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@thepulseapi.com
NEXT_PUBLIC_PARTNERS_EMAIL=partners@thepulseapi.com
NEXT_PUBLIC_PRESS_EMAIL=press@thepulseapi.com
NEXT_PUBLIC_CAREERS_EMAIL=careers@thepulseapi.com

# The scheduler behind "Book a 30 minute call". Unset hides the card entirely, which is the right
# failure: a booking card that leads nowhere is worse than no card. A link, not Calendly's embed,
# so no third-party script loads until someone clicks.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/sumanbonakurthi/30min

# --- feature flags ---------------------------------------------------------

# Renders "Continue with Google" only when "true". The button is absent rather than disabled when
# the provider is not configured, and the server makes the same check against GOOGLE_CLIENT_ID so
# the two cannot disagree about whether the provider exists.
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Turnstile holds no configuration here at all. The widget fetches its site key at runtime from
# the gateway (`/public/forms/config`), which is the same place the secret lives, so the key can
# be rotated without rebuilding this site.
